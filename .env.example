# Telegram bot token from @BotFather
BOT_TOKEN=

# Admin dashboard password (send as x-admin-key header)
ADMIN_KEY=change-me

# PostgreSQL connection string. In Bolt, SUPABASE_DB_URL is pre-populated.
# Local dev: postgresql://postgres:postgres@localhost:5432/ethiolottery
DATABASE_URL=

# Server
PORT=3000
TICKET_PRICE=10
USE_WEBHOOK=false
PUBLIC_URL=https://yourdomain.com

# Telebirr merchant API (Ethio Telecom)
TELEBIRR_BASE_URL=https://api.telebirr.com
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_PRIVATE_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_NOTIFY_URL=${PUBLIC_URL}/api/payments/telebirr/notify
TELEBIRR_RETURN_URL=https://t.me/YourBot

# CBE Birr merchant API (Commercial Bank of Ethiopia)
CBE_BASE_URL=https://api.cbe.com.et/cbebirrmerchant
CBE_MERCHANT_ID=
CBE_API_KEY=
CBE_NOTIFY_URL=${PUBLIC_URL}/api/payments/cbe/notify
